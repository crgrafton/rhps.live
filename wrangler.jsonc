{
  "name": "rhps-api",
  "main": "workers/src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rhps-db",
      "database_id": "86191834-e507-4ee2-8e53-65a5a55f8cce"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ACTIVE_ADS",
      "id": "e376d29960924f93b3af022fd403b079"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "0 3 * * 1"
    ]
  }
}
